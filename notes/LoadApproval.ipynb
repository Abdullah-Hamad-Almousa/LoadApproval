#%%
"""
LoadApproval Analysis - Annotated Notes
=======================================

This script demonstrates a Machine Learning pipeline for Load Approval.
It has been annotated to explain the purpose of each section.

Key Steps:
1. Load and Prepare Data
2. Preprocess Features (Numeric & Categorical)
3. Train Decision Tree Model
4. Evaluate and Visualize
"""

import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.metrics import classification_report, confusion_matrix
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer

def loadData() -> pd.DataFrame:
    """
    NOTE: Data Loading
    ------------------
    Reads the dataset from a CSV file.
    """
    return pd.read_csv("data.csv")

def prepareData(df):
    """
    NOTE: Data Preparation
    ----------------------
    Separates the Features (X) from the Target (y).
    
    Assumptions:
    - The target variable is located in the last column.
    """
    targetColumn = df.columns[-1]
    x = df.drop(columns=[targetColumn])
    y = df[targetColumn]
    return x, y

def createPreprocessor(x):
    """
    NOTE: Preprocessing Pipeline
    ----------------------------
    Creates a ColumnTransformer to handle:
    1. Numeric Features: Imputation (Median) + Scaling (StandardScaler)
    2. Categorical Features: Imputation (Most Frequent) + One-Hot Encoding
    """
    # Identify feature types dynamically
    numericFeatures = x.select_dtypes(include=["int64", "float64"]).columns
    categoricalFeatures = x.select_dtypes(include=["object"]).columns

    # NOTE: Pipeline for numeric data
    # - SimpleImputer fills missing values with the median.
    # - StandardScaler scales data to unit variance (important for some models).
    numericTransformer = Pipeline(
        steps=[
            ("imputer", SimpleImputer(strategy="median")),
            ("scaler", StandardScaler())
        ]
    )

    # NOTE: Pipeline for categorical data
    # - SimpleImputer fills missing values with the most frequent category.
    # - OneHotEncoder converts strings to binary columns.
    #   handle_unknown="ignore" prevents errors if new categories appear in test data.
    categoricalTransformer = Pipeline(
        steps=[
            ("imputer", SimpleImputer(strategy="most_frequent")),
            ("onehot", OneHotEncoder(handle_unknown="ignore", sparse_output=False))
        ]
    )

    # Combine both pipelines
    return ColumnTransformer(
        transformers=[
            ("num", numericTransformer, numericFeatures),
            ("cat", categoricalTransformer, categoricalFeatures)
        ]
    )

def trainModel(xTrain, yTrain, preprocessor):
    """
    NOTE: Model Training
    --------------------
    Combines the preprocessor and the classifier into a single pipeline.
    This ensures all data fed to the model is preprocessed automatically.
    """
    model = Pipeline(
        steps=[
            ("preprocessor", preprocessor),
            ("classifier", DecisionTreeClassifier(random_state=42))
        ]
    )
    model.fit(xTrain, yTrain)
    return model

def evaluateModel(model, xTest, yTest):
    """
    NOTE: Evaluation
    ----------------
    Predicts on test data and prints classification metrics.
    """
    yPred = model.predict(xTest)
    print("Model Evaluation Results:")
    print("=" * 40)
    print(classification_report(yTest, yPred))
    print("Confusion Matrix:")
    print(confusion_matrix(yTest, yPred))
    return yPred

def visualizeTree(model, featureNames):
    """
    NOTE: Visualization
    -------------------
    Plots the Decision Tree logic for interpretability.
    """
    classifier = model.named_steps["classifier"]
    plt.figure(figsize=(20, 10))
    plot_tree(
        classifier,
        feature_names=featureNames,
        filled=True,
        rounded=True
    )
    plt.show()

def interactivePrediction(model, x):
    """
    NOTE: Interactive Mode
    ----------------------
    Allows the user to input values manually to test the model.
    """
    inputData = {}
    for column in x.columns:
        value = input(f"Enter value for {column}: ")
        # NOTE: Wrap value in a list [] to create a DataFrame row
        inputData[column] = [value]
    inputDf = pd.DataFrame(inputData)
    
    prediction = model.predict(inputDf)[0]
    probability = model.predict_proba(inputDf)[0]
    
    print(f"Prediction: {prediction}")
    print(f"Probability: {probability}")

def main():
    print("--- NOTE: Starting LoadApproval Pipeline ---")
    print("1. Loading data...")
    df = loadData()
    print(f"Dataset shape: {df.shape}")

    print("\n2. Preparing data...")
    x, y = prepareData(df)

    # NOTE: Split data 80% Training / 20% Testing
    xTrain, xTest, yTrain, yTest = train_test_split(
        x, y, test_size=0.2, random_state=42
    )

    print("3. Creating preprocessing pipeline...")
    preprocessor = createPreprocessor(xTrain)

    print("4. Training model...")
    model = trainModel(xTrain, yTrain, preprocessor)

    print("\n5. Evaluating model...")
    evaluateModel(model, xTest, yTest)

    print("\n6. Visualizing Decision Tree...")
    # NOTE: Retrieve feature names generated by OneHotEncoder
    processedFeatureNames = model.named_steps["preprocessor"].get_feature_names_out()
    visualizeTree(model, processedFeatureNames)

    print("\n7. Interactive Prediction Mode")
    interactivePrediction(model, x)

    return model

if __name__ == "__main__":
    main()

#%%
